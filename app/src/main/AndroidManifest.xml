<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local run/approval notifications. Requested contextually at
         runtime (Android 13+); the app is fully functional without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground continuity for an active agent run. dataSync type:
         a user-initiated, continuous data exchange with the Hermes server.
         No runtime permission is required for this type (verified against
         the official foreground-service-type documentation). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Hermes">
        <!-- Official edge-to-edge setup: with adjustResize the app
             receives IME insets (consumed once in ChatScreen via
             WindowInsets.ime), so the window is never panned when the
             keyboard opens. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Product Gate: pairing deep link (orsik://pair?server=...&code=...)
                 lets a fresh app auto-discover the server without manual entry. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orsik" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- Keeps the process out of the cached state while an agent
             run is active, so the cached-app freezer cannot terminate the
             run's SSE sockets. Owns no chat state; see the class doc. -->
        <service
            android:name=".platform.run.RunForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
